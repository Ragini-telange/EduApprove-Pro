# ==============================================================================
# EDUAPPROVE PRO — FASTAPI BACKEND CONFIGURATION
# Copy this file to .env or set environment variables in your deployment.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME DATA MODE
# ------------------------------------------------------------------------------
# Set to 'mock' for local offline testing and mock repositories (default).
# Set to 'live' to require authentic Supabase Bearer JWTs and enforce live fail-closed security.
EDUAPPROVE_DATA_MODE=mock

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT IDENTIFIERS
# ------------------------------------------------------------------------------
# The HTTPS URL of your Supabase project (from Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://wsdmvjmhxbaxrdhfyuwm.supabase.co


# ------------------------------------------------------------------------------
# 3. JWT SIGNING ALGORITHM & CLAIMS VALIDATION
# ------------------------------------------------------------------------------
# Expected JWT signing algorithm: 'HS256' (symmetric), 'RS256' (asymmetric), or 'ES256' (asymmetric)
# If left empty, automatically defaults to HS256 when SUPABASE_JWT_SECRET is set,
# or RS256 when SUPABASE_JWKS_URL / SUPABASE_PUBLIC_KEY is provided.
SUPABASE_JWT_ALGORITHM=HS256

# Expected JWT audience claim ('aud'). Standard Supabase session tokens carry 'authenticated'.
SUPABASE_JWT_AUDIENCE=authenticated

# Expected JWT issuer claim ('iss').
# Standard format: https://<your-project-ref>.supabase.co/auth/v1
# If left empty, will automatically be derived from SUPABASE_URL if set.
SUPABASE_JWT_ISSUER=

# ------------------------------------------------------------------------------
# 4. JWT SIGNING KEYS (Configure Option A OR Option B)
# ------------------------------------------------------------------------------
# Option A: Symmetric HS256 Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Secret)
# Used for projects where Supabase signs tokens with a shared secret.
SUPABASE_JWT_SECRET=

# Option B: Asymmetric RS256 / ES256 JWKS Endpoint
# Used for modern Supabase projects with asymmetric signing keys.
# Standard endpoint: https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Option C: Static Public Key (PEM formatted string if JWKS endpoint is unreachable offline)
SUPABASE_PUBLIC_KEY=
