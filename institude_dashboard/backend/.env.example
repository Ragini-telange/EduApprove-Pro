# AICTE SmartAssist - Backend Environment Configuration

# Database configuration
# Leave empty or set to sqlite:///./aicte_smartassist.db for local SQLite development
# For Supabase / PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./aicte_smartassist.db

# Institution Identity
INSTITUTION_ID=AICTE-INS-10245
INSTITUTION_NAME=Government College of Engineering

# App Environment
ENVIRONMENT=development
API_V1_STR=/api
PROJECT_NAME="AICTE SmartAssist - Institution Admin Portal"

# Supabase Storage Configuration (Optional - local uploads fallback is active when not configured)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=aicte-documents

# AI Assistant Configuration (Optional - built-in institutional intelligence fallback is active)
OPENAI_API_KEY=
