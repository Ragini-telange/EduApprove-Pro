{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Run Both (Backend + Frontend)",
      "dependsOn": [
        "Start Backend (FastAPI)",
        "Start Frontend (Vite)"
      ],
      "problemMatcher": []
    }
  ]
}
